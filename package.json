{
  "name": "melodytrack-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsgo -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "format": "biome format . --write",
    "format:check": "biome format .",
    "lint:biome": "biome lint .",
    "lint:architecture": "steiger ./src",
    "check:assets": "node ./scripts/check-public-assets.mjs",
    "typecheck": "tsgo -b",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run format && npm run lint:fix && npm run lint:biome && npm run lint:architecture && npm run check:assets && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.100.10",
    "@xyflow/react": "^12.11.0",
    "antd": "^6.4.2",
    "axios": "^1.16.1",
    "dayjs": "^1.11.20",
    "elkjs": "^0.11.1",
    "libphonenumber-js": "^1.13.3",
    "lucide-react": "^1.16.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-imask": "^7.6.1",
    "react-router": "^8.3.0",
    "sceditor": "^3.2.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@eslint/js": "^10.0.1",
    "@feature-sliced/steiger-plugin": "^0.7.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.8.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript/native-preview": "^7.0.0-dev.20260421.2",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^10.4.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "steiger": "^0.6.0",
    "typescript-eslint": "^8.59.3",
    "vite": "^8.0.13",
    "vitest": "^4.1.10"
  }
}
