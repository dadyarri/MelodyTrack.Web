{
  "name": "melodytrack-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "format": "biome format src eslint.config.js package.json tsconfig.json tsconfig.app.json tsconfig.node.json vite.config.ts biome.json --write",
    "format:check": "biome format src eslint.config.js package.json tsconfig.json tsconfig.app.json tsconfig.node.json vite.config.ts biome.json",
    "lint:biome": "biome lint src eslint.config.js vite.config.ts",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@ant-design/icons": "^6.1.0",
    "@tanstack/react-query": "^5.90.10",
    "antd": "^6.0.0",
    "axios": "^1.13.2",
    "dayjs": "^1.11.19",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-imask": "^7.6.1",
    "react-router": "^7.9.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4"
  }
}
